{
  "name": "dsh-blog",
  "version": "1.0.0",
  "description": "DeepSeek Harness 插件：AI 长文工厂，自动研究、写作与发布到 GitHub Pages",
  "type": "module",
  "main": "src/host.js",
  "exports": {
    ".": "./src/host.js",
    "./client": "./dist/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "docs/USAGE.md",
    "docs/GITHUB_PAGES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "test": "node --test test/*.test.js",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@milkdown/kit": "^7.23.0",
    "esbuild": "^0.28.2"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "blog"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a1ertx5s/dsh-blog.git"
  },
  "dependencies": {
    "markdown-it": "^15.0.3",
    "sanitize-html": "^2.18.1",
    "yaml": "^2.9.1"
  }
}
